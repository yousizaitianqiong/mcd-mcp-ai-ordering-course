# 运行模式：mock 或 mcd。没有真实 Token 时建议使用 mock。
APP_MODE=mock
PORT=8787
APP_ORIGIN=http://localhost:5173
DATA_FILE=./data/app-state.json

# 麦当劳中国官方 MCP
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=
MCD_MCP_PROTOCOL_VERSION=2025-06-18
# 远端金额单位；只有服务端明确返回分单位时才设为 fen。
MCD_MONEY_UNIT=yuan

# OpenAI 兼容模型 API。留空时使用内置规则式 Mock Agent。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_MAX_TURNS=8
